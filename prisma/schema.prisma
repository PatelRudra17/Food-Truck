// Enterprise Inventory & Logistics Management System
// Prisma schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================
// AUTH / RBAC
// ==================================================

model User {
  id            String    @id @default(cuid())
  employeeId    String?   @unique
  name          String
  email         String    @unique
  passwordHash  String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  isDemoUser    Boolean   @default(false)
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions            Session[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  createdInwards      StockInward[]      @relation("InwardReceivedBy")
  requestedOutwards   StockOutward[]     @relation("OutwardRequestedBy")
  approvedOutwards    StockOutward[]     @relation("OutwardApprovedBy")
  requestedTransfers  StockTransfer[]    @relation("TransferRequestedBy")
  approvedTransfers   StockTransfer[]    @relation("TransferApprovedBy")
  createdAdjustments  StockAdjustment[]  @relation("AdjustmentCreatedBy")
  approvedAdjustments StockAdjustment[]  @relation("AdjustmentApprovedBy")
  createdPOs          PurchaseOrder[]    @relation("POCreatedBy")
  approvedPOs         PurchaseOrder[]    @relation("POApprovedBy")
  ledgerEntries       InventoryLedger[]
  uploadedAttachments Attachment[]
  documentAccess      DocumentAccessLog[]
  approvals           Approval[]         @relation("ApprovalDecidedBy")
  approvalRequests    Approval[]         @relation("ApprovalRequestedBy")
  fuelEntries         FuelEntry[]        @relation("FuelEnteredBy")
  voidedFuelEntries   FuelEntry[]        @relation("FuelVoidedBy")
  maintenanceRecords  VehicleMaintenance[] @relation("MaintenanceCreatedBy")
  archivedMaintenance VehicleMaintenance[] @relation("MaintenanceArchivedBy")
  temperatureLogs     StorageTemperatureLog[]
  managedWarehouses   Warehouse[]
  gateEntriesStaffed  VehicleGateEntry[]
  settingsUpdated     SystemSetting[]

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
  notifications Notification[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

// ==================================================
// MASTER DATA
// ==================================================

model Category {
  id          String     @id @default(cuid())
  name        String
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  items Item[]

  @@unique([name, parentId])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  managerId String?
  manager   User?    @relation(fields: [managerId], references: [id])
  contact   String?
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations         Location[]
  items             Item[]
  inwards           StockInward[]
  outwards          StockOutward[]
  transfersOut      StockTransfer[]    @relation("TransferSource")
  transfersIn       StockTransfer[]    @relation("TransferDest")
  adjustments       StockAdjustment[]
  ledgerEntries     InventoryLedger[]
  temperatureLogs   StorageTemperatureLog[]

  @@index([status])
}

model Location {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  rack        String?
  shelf       String?
  bin         String?
  createdAt   DateTime  @default(now())

  items           Item[]
  temperatureLogs StorageTemperatureLog[]

  @@unique([warehouseId, rack, shelf, bin])
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  companyName   String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  panNumber     String?
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          Item[]
  purchaseOrders PurchaseOrder[]
  inwards        StockInward[]
  gateEntries    VehicleGateEntry[]
  attachments    Attachment[] @relation("SupplierAttachments")

  @@index([status])
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum StorageType {
  AMBIENT
  COLD_ROOM
  FROZEN
  DRY_STORAGE
  CONTROLLED_ATMOSPHERE
  OTHER
}

model Item {
  id               String   @id @default(cuid())
  sku              String   @unique
  itemCode         String   @unique
  name             String
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  brand            String?
  description      String?
  unit             String
  minStock         Decimal  @default(0) @db.Decimal(14, 3)
  maxStock         Decimal? @db.Decimal(14, 3)
  reorderLevel     Decimal  @default(0) @db.Decimal(14, 3)
  openingStock     Decimal  @default(0) @db.Decimal(14, 3)
  currentStock     Decimal  @default(0) @db.Decimal(14, 3)
  warehouseId      String?
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  locationId       String?
  location         Location?  @relation(fields: [locationId], references: [id])
  supplierId       String?
  supplier         Supplier?  @relation(fields: [supplierId], references: [id])
  purchasePrice    Decimal? @db.Decimal(14, 2)
  taxPercent       Decimal? @db.Decimal(5, 2)
  hsnCode          String?
  barcode          String?  @unique
  qrCodePayload    String?  @unique
  batchTracked     Boolean  @default(false)
  serialTracked    Boolean  @default(false)
  expiryTracked    Boolean  @default(false)
  imageUrl         String?
  isActive         Boolean  @default(true)

  // Plan2: vegetable storage / temperature management
  isTemperatureSensitive Boolean  @default(false)
  storageMinTempC        Decimal? @db.Decimal(5, 2)
  storageMaxTempC        Decimal? @db.Decimal(5, 2)
  storageType            StorageType?
  storageLocationText    String?
  shelfLifeDays          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inwardItems      StockInwardItem[]
  outwardItems     StockOutwardItem[]
  transferItems    StockTransferItem[]
  adjustments      StockAdjustment[]
  ledgerEntries    InventoryLedger[]
  poItems          PurchaseOrderItem[]
  temperatureLogs  StorageTemperatureLog[]
  attachments      Attachment[] @relation("ItemAttachments")

  @@index([categoryId])
  @@index([warehouseId])
  @@index([isActive])
  @@index([name])
}

// ==================================================
// INVENTORY ENGINE
// ==================================================

enum LedgerTxnType {
  OPENING
  INWARD
  OUTWARD
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  DAMAGED_DISPOSED
}

model InventoryLedger {
  id              String        @id @default(cuid())
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  transactionType LedgerTxnType
  quantity        Decimal       @db.Decimal(14, 3)
  beforeQty       Decimal       @db.Decimal(14, 3)
  afterQty        Decimal       @db.Decimal(14, 3)
  referenceType   String
  referenceId     String
  referenceNumber String
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  reason          String?
  createdAt       DateTime      @default(now())

  @@index([itemId])
  @@index([warehouseId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum InwardStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

model StockInward {
  id             String       @id @default(cuid())
  inwardNumber   String       @unique
  date           DateTime
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  invoiceNumber  String?
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  receivedById   String
  receivedBy     User         @relation("InwardReceivedBy", fields: [receivedById], references: [id])
  remarks        String?
  status         InwardStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items       StockInwardItem[]
  attachments Attachment[] @relation("InwardAttachments")
  approvals   Approval[]   @relation("InwardApprovals")

  @@index([status])
  @@index([date])
}

model StockInwardItem {
  id           String   @id @default(cuid())
  inwardId     String
  inward       StockInward @relation(fields: [inwardId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  quantity     Decimal  @db.Decimal(14, 3)
  unit         String
  batchNumber  String?
  serialNumber String?
  expiryDate   DateTime?
  rate         Decimal? @db.Decimal(14, 2)
  taxPercent   Decimal? @db.Decimal(5, 2)
  total        Decimal? @db.Decimal(14, 2)

  @@index([inwardId])
  @@index([itemId])
}

enum OutwardStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  REJECTED
  CANCELLED
}

model StockOutward {
  id            String        @id @default(cuid())
  outwardNumber String        @unique
  date          DateTime
  department    String?
  project       String?
  requestedById String
  requestedBy   User          @relation("OutwardRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?         @relation("OutwardApprovedBy", fields: [approvedById], references: [id])
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])
  driverId      String?
  driver        Driver?       @relation(fields: [driverId], references: [id])
  destination   String?
  receiver      String?
  purpose       String?
  remarks       String?
  status        OutwardStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items       StockOutwardItem[]
  attachments Attachment[] @relation("OutwardAttachments")
  approvals   Approval[]   @relation("OutwardApprovals")

  @@index([status])
  @@index([date])
}

model StockOutwardItem {
  id               String   @id @default(cuid())
  outwardId        String
  outward          StockOutward @relation(fields: [outwardId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item     @relation(fields: [itemId], references: [id])
  availableQtySnapshot Decimal @db.Decimal(14, 3)
  requestedQty     Decimal  @db.Decimal(14, 3)
  unit             String
  batchNumber      String?
  serialNumber     String?

  @@index([outwardId])
  @@index([itemId])
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  REJECTED
  CANCELLED
}

model StockTransfer {
  id                 String         @id @default(cuid())
  transferNumber     String         @unique
  sourceWarehouseId  String
  sourceWarehouse    Warehouse      @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destWarehouseId    String
  destWarehouse      Warehouse      @relation("TransferDest", fields: [destWarehouseId], references: [id])
  requestedById      String
  requestedBy        User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedById       String?
  approvedBy         User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  dispatchDate       DateTime?
  receivedDate       DateTime?
  remarks            String?
  status             TransferStatus @default(DRAFT)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items     StockTransferItem[]
  approvals Approval[] @relation("TransferApprovals")

  @@index([status])
}

model StockTransferItem {
  id          String   @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  quantity    Decimal  @db.Decimal(14, 3)
  unit        String
  batchNumber String?

  @@index([transferId])
  @@index([itemId])
}

enum AdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model StockAdjustment {
  id               String           @id @default(cuid())
  adjustmentNumber String           @unique
  itemId           String
  item             Item             @relation(fields: [itemId], references: [id])
  warehouseId      String
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  currentQty       Decimal          @db.Decimal(14, 3)
  physicalQty      Decimal          @db.Decimal(14, 3)
  difference       Decimal          @db.Decimal(14, 3)
  reason           String
  createdById      String
  createdBy        User             @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  approvedById     String?
  approvedBy       User?            @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id])
  status           AdjustmentStatus @default(PENDING_APPROVAL)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attachments Attachment[] @relation("AdjustmentAttachments")
  approvals   Approval[]   @relation("AdjustmentApprovals")

  @@index([status])
  @@index([itemId])
}

// ==================================================
// PURCHASE ORDERS
// ==================================================

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               String   @id @default(cuid())
  poNumber         String   @unique
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  date             DateTime
  expectedDelivery DateTime?
  createdById      String
  createdBy        User     @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById     String?
  approvedBy       User?    @relation("POApprovedBy", fields: [approvedById], references: [id])
  remarks          String?
  totalAmount      Decimal  @default(0) @db.Decimal(14, 2)
  status           POStatus @default(DRAFT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items    PurchaseOrderItem[]
  inwards  StockInward[]
  approvals Approval[] @relation("POApprovals")

  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  poId             String
  po               PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item          @relation(fields: [itemId], references: [id])
  quantity         Decimal       @db.Decimal(14, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 3)
  rate             Decimal       @db.Decimal(14, 2)
  taxPercent       Decimal?      @db.Decimal(5, 2)
  total            Decimal       @db.Decimal(14, 2)

  @@index([poId])
  @@index([itemId])
}

// ==================================================
// VEHICLE MANAGEMENT (+ plan2: fuel & maintenance)
// ==================================================

enum VehicleStatus {
  AVAILABLE
  INSIDE
  OUTSIDE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

enum MaintenanceState {
  UP_TO_DATE
  DUE_SOON
  DUE
  OVERDUE
}

model Vehicle {
  id                  String        @id @default(cuid())
  vehicleNumber       String        @unique
  vehicleType         String
  manufacturer        String?
  model               String?
  ownerCompany        String?
  registrationDate    DateTime?
  registrationExpiry  DateTime?
  insuranceExpiry     DateTime?
  pucExpiry           DateTime?
  fitnessExpiry       DateTime?
  permitExpiry        DateTime?
  capacity            String?
  currentDriverId     String?
  currentDriver       Driver?       @relation("CurrentVehicle", fields: [currentDriverId], references: [id])
  currentLocation     String?
  status              VehicleStatus @default(AVAILABLE)
  imageUrl            String?

  // Plan2: fuel management
  fuelType              String?
  odometerKm            Decimal  @default(0) @db.Decimal(12, 1)
  fuelEfficiencyTargetKmpl Decimal? @db.Decimal(8, 2)
  fuelCostPerKmTarget   Decimal? @db.Decimal(8, 2)

  // Plan2: maintenance management
  lastServiceDate       DateTime?
  lastServiceKm         Decimal?  @db.Decimal(12, 1)
  nextServiceDate       DateTime?
  nextServiceKm         Decimal?  @db.Decimal(12, 1)
  serviceIntervalDays   Int?
  serviceIntervalKm     Decimal?  @db.Decimal(12, 1)
  maintenanceState      MaintenanceState @default(UP_TO_DATE)
  maintenanceOverride   Boolean   @default(false)
  maintenanceOverrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       VehicleDocument[]
  gateEntries     VehicleGateEntry[]
  gateExits       VehicleGateExit[]
  inwards         StockInward[]
  outwards        StockOutward[]
  fuelEntries     FuelEntry[]
  maintenanceRecords VehicleMaintenance[]
  attachments     Attachment[] @relation("VehicleAttachments")

  @@index([status])
  @@index([maintenanceState])
}

enum VehicleDocType {
  REGISTRATION
  INSURANCE
  PUC
  FITNESS
  PERMIT
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

model VehicleDocument {
  id              String              @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  docType         VehicleDocType
  docNumber       String?
  issueDate       DateTime?
  expiryDate      DateTime?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt       DateTime            @default(now())

  attachments Attachment[] @relation("VehicleDocAttachments")

  @@index([vehicleId])
  @@index([expiryDate])
}

enum PersonStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model Driver {
  id               String       @id @default(cuid())
  employeeId       String?      @unique
  fullName         String
  mobile           String
  altMobile        String?
  address          String?
  dob              DateTime?
  joiningDate      DateTime?
  emergencyContact String?
  profilePhotoUrl  String?
  status           PersonStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  documents      DriverDocument[]
  vehicles       Vehicle[]        @relation("CurrentVehicle")
  gateEntries    VehicleGateEntry[]
  gateExits      VehicleGateExit[]
  inwards        StockInward[]
  outwards       StockOutward[]
  fuelEntries    FuelEntry[]
  attachments    Attachment[] @relation("DriverAttachments")

  @@index([status])
}

enum DriverDocType {
  AADHAAR
  PAN
  DRIVING_LICENCE
  ADDRESS_PROOF
  MEDICAL_FITNESS
  POLICE_VERIFICATION
  TRAINING_CERTIFICATE
  OTHER
}

// Sensitive identity documents: numbers stored encrypted (AES-256-GCM) with only
// a precomputed masked string kept in plaintext for display purposes.
model DriverDocument {
  id                 String              @id @default(cuid())
  driverId           String
  driver             Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  docType            DriverDocType
  numberEncrypted    String?             // ciphertext, never returned to client directly
  numberMasked       String?             // e.g. "XXXX XXXX 4821"
  licenceClass       String?
  issueDate          DateTime?
  expiryDate         DateTime?
  issuingAuthority   String?
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  isSensitive        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attachments Attachment[] @relation("DriverDocAttachments")

  @@index([driverId])
  @@index([expiryDate])
}

// ==================================================
// VEHICLE GATE ENTRY / EXIT
// ==================================================

enum GateStatus {
  INSIDE
  OUT
}

model VehicleGateEntry {
  id              String     @id @default(cuid())
  gateEntryNumber String     @unique
  vehicleId       String
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
  driverId        String
  driver          Driver     @relation(fields: [driverId], references: [id])
  supplierId      String?
  supplier        Supplier?  @relation(fields: [supplierId], references: [id])
  purpose         String?
  material        String?
  timeIn          DateTime   @default(now())
  securityStaffId String
  securityStaff   User       @relation(fields: [securityStaffId], references: [id])
  remarks         String?
  status          GateStatus @default(INSIDE)
  createdAt       DateTime   @default(now())

  exit VehicleGateExit?

  @@index([status])
  @@index([vehicleId])
}

model VehicleGateExit {
  id                    String   @id @default(cuid())
  gateExitNumber        String   @unique
  gateEntryId           String   @unique
  gateEntry             VehicleGateEntry @relation(fields: [gateEntryId], references: [id])
  vehicleId             String
  vehicle               Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId              String
  driver                Driver   @relation(fields: [driverId], references: [id])
  timeOut               DateTime @default(now())
  destination           String?
  material              String?
  receiver              String?
  remarks               String?
  totalTimeInsideMinutes Int
  createdAt             DateTime @default(now())

  @@index([vehicleId])
}

// ==================================================
// PLAN2: FLEET FUEL MANAGEMENT
// ==================================================

model FuelEntry {
  id                  String   @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id])
  date                DateTime
  driverId            String?
  driver              Driver?  @relation(fields: [driverId], references: [id])
  tripId              String?
  fuelStationVendor   String?
  fuelType            String
  previousOdometerKm  Decimal  @db.Decimal(12, 1)
  currentOdometerKm   Decimal  @db.Decimal(12, 1)
  distanceKm          Decimal  @db.Decimal(12, 1)
  fuelQuantityLiters  Decimal  @db.Decimal(10, 2)
  fuelRate            Decimal  @db.Decimal(10, 2)
  totalFuelCost       Decimal  @db.Decimal(12, 2)
  mileageKmpl         Decimal? @db.Decimal(8, 2)
  fuelCostPerKm       Decimal? @db.Decimal(8, 2)
  isAnomaly           Boolean  @default(false)
  anomalyNote         String?
  remarks             String?
  enteredById         String
  enteredBy           User     @relation("FuelEnteredBy", fields: [enteredById], references: [id])
  isVoided            Boolean  @default(false)
  voidReason          String?
  voidedById          String?
  voidedBy            User?    @relation("FuelVoidedBy", fields: [voidedById], references: [id])
  voidedAt            DateTime?
  createdAt           DateTime @default(now())

  attachments Attachment[] @relation("FuelAttachments")

  @@index([vehicleId])
  @@index([date])
}

// ==================================================
// PLAN2: VEHICLE MAINTENANCE MANAGEMENT
// ==================================================

enum MaintenanceType {
  REGULAR_SERVICE
  PREVENTIVE_MAINTENANCE
  OIL_CHANGE
  TYRE_REPLACEMENT
  BRAKE_SERVICE
  ENGINE_REPAIR
  ELECTRICAL_REPAIR
  ACCIDENT_REPAIR
  EMERGENCY_REPAIR
  OTHER
}

model VehicleMaintenance {
  id                String          @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])
  maintenanceType   MaintenanceType
  serviceDate       DateTime
  odometerKm        Decimal         @db.Decimal(12, 1)
  serviceCenterVendor String?
  technician        String?
  workPerformed     String?
  partsReplaced     String?
  labourCost        Decimal         @default(0) @db.Decimal(12, 2)
  partsCost         Decimal         @default(0) @db.Decimal(12, 2)
  otherCost         Decimal         @default(0) @db.Decimal(12, 2)
  totalCost         Decimal         @db.Decimal(12, 2)
  remarks           String?
  createdById       String
  createdBy         User            @relation("MaintenanceCreatedBy", fields: [createdById], references: [id])
  isArchived        Boolean         @default(false)
  archiveReason     String?
  archivedById      String?
  archivedBy        User?           @relation("MaintenanceArchivedBy", fields: [archivedById], references: [id])
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())

  attachments Attachment[] @relation("MaintenanceAttachments")

  @@index([vehicleId])
  @@index([serviceDate])
}

// ==================================================
// PLAN2: VEGETABLE STORAGE TEMPERATURE MONITORING
// ==================================================

enum TemperatureStatus {
  NORMAL
  WARNING
  CRITICAL
}

enum TemperatureSource {
  MANUAL
  SENSOR
}

model StorageTemperatureLog {
  id               String            @id @default(cuid())
  itemId           String
  item             Item              @relation(fields: [itemId], references: [id])
  batchNumber      String?
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  locationId       String?
  location         Location?         @relation(fields: [locationId], references: [id])
  recordedTempC    Decimal           @db.Decimal(5, 2)
  recordedAt       DateTime          @default(now())
  recordedById     String
  recordedBy       User              @relation(fields: [recordedById], references: [id])
  status           TemperatureStatus
  source           TemperatureSource @default(MANUAL)
  remarks          String?

  @@index([itemId])
  @@index([warehouseId])
  @@index([recordedAt])
  @@index([status])
}

// ==================================================
// NOTIFICATIONS / AUDIT / DOCUMENTS / APPROVALS / SETTINGS
// ==================================================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  PENDING_APPROVAL
  TRANSFER_PENDING
  PO_PENDING
  MAINTENANCE_DUE
  TEMPERATURE_ALERT
  FUEL_ANOMALY
  SYSTEM_ALERT
}

model Notification {
  id         String           @id @default(cuid())
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])
  roleId     String?
  role       Role?            @relation(fields: [roleId], references: [id])
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// Immutable audit trail — application layer must never expose update/delete for this model.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Attachment {
  id            String    @id @default(cuid())
  fileName      String
  storageKey    String    @unique
  mimeType      String
  sizeBytes     Int
  entityType    String
  entityId      String
  documentType  String?
  expiryDate    DateTime?
  isSensitive   Boolean   @default(false)
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime  @default(now())
  version       Int       @default(1)
  isDeleted     Boolean   @default(false)

  item        Item?       @relation("ItemAttachments", fields: [itemFk], references: [id])
  itemFk      String?
  supplier    Supplier?   @relation("SupplierAttachments", fields: [supplierFk], references: [id])
  supplierFk  String?
  vehicle     Vehicle?    @relation("VehicleAttachments", fields: [vehicleFk], references: [id])
  vehicleFk   String?
  driver      Driver?     @relation("DriverAttachments", fields: [driverFk], references: [id])
  driverFk    String?
  vehicleDoc  VehicleDocument? @relation("VehicleDocAttachments", fields: [vehicleDocFk], references: [id])
  vehicleDocFk String?
  driverDoc   DriverDocument? @relation("DriverDocAttachments", fields: [driverDocFk], references: [id])
  driverDocFk String?
  inward      StockInward? @relation("InwardAttachments", fields: [inwardFk], references: [id])
  inwardFk    String?
  outward     StockOutward? @relation("OutwardAttachments", fields: [outwardFk], references: [id])
  outwardFk   String?
  adjustment  StockAdjustment? @relation("AdjustmentAttachments", fields: [adjustmentFk], references: [id])
  adjustmentFk String?
  fuelEntry   FuelEntry? @relation("FuelAttachments", fields: [fuelEntryFk], references: [id])
  fuelEntryFk String?
  maintenance VehicleMaintenance? @relation("MaintenanceAttachments", fields: [maintenanceFk], references: [id])
  maintenanceFk String?

  accessLogs DocumentAccessLog[]

  @@index([entityType, entityId])
  @@index([isSensitive])
}

enum DocumentAction {
  VIEW
  DOWNLOAD
}

model DocumentAccessLog {
  id           String         @id @default(cuid())
  attachmentId String
  attachment   Attachment     @relation(fields: [attachmentId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  action       DocumentAction
  createdAt    DateTime       @default(now())

  @@index([attachmentId])
  @@index([userId])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id            String           @id @default(cuid())
  entityType    String
  entityId      String
  requestedById String
  requestedBy   User             @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime         @default(now())
  decidedById   String?
  decidedBy     User?            @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decision      ApprovalDecision @default(PENDING)
  comment       String?

  outward    StockOutward?    @relation("OutwardApprovals", fields: [outwardFk], references: [id])
  outwardFk  String?
  adjustment StockAdjustment? @relation("AdjustmentApprovals", fields: [adjustmentFk], references: [id])
  adjustmentFk String?
  po         PurchaseOrder?   @relation("POApprovals", fields: [poFk], references: [id])
  poFk       String?
  transfer   StockTransfer?   @relation("TransferApprovals", fields: [transferFk], references: [id])
  transferFk String?
  inward     StockInward?     @relation("InwardApprovals", fields: [inwardFk], references: [id])
  inwardFk   String?

  @@index([entityType, entityId])
  @@index([decision])
}

// Backs sequential, human-readable document numbers (INW-2026-000123, etc).
// Incremented inside the same transaction as the document that consumes it.
model NumberSequence {
  key          String   @id // e.g. "STOCK_INWARD-2026"
  lastValue    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model SystemSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         Json
  updatedById   String?
  updatedBy     User?    @relation(fields: [updatedById], references: [id])
  updatedAt     DateTime @updatedAt
}
