# ==================================================
# Enterprise Inventory & Logistics Management System
# Environment configuration template.
# Copy to .env for local development: cp .env.example .env
# NEVER commit the real .env file.
# ==================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://inventory_app:change_me@localhost:5442/inventory_db?schema=public"

# --- Session / Auth ---
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-64-char-random-hex-string"
SESSION_COOKIE_NAME="eils_session"
SESSION_TTL_HOURS="12"

# --- Field-level encryption (Aadhaar/PAN/DL numbers at rest) ---
# Generate with: openssl rand -hex 32  (must be 32 bytes / 64 hex chars for AES-256-GCM)
DOCUMENT_ENCRYPTION_KEY="replace-with-a-64-char-random-hex-string"

# --- Object storage (S3-compatible, e.g. MinIO for local dev) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="inventory-documents"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_FORCE_PATH_STYLE="true"
# Seconds a signed document URL remains valid
STORAGE_SIGNED_URL_TTL="300"

# --- Application ---
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"

# --- Negative stock policy (can also be changed at runtime via System Settings) ---
ALLOW_NEGATIVE_STOCK="false"

# --- Rate limiting ---
RATE_LIMIT_LOGIN_MAX_ATTEMPTS="5"
RATE_LIMIT_LOGIN_WINDOW_MINUTES="15"
